{
  "realm": "nexus",
  "enabled": true,
  "displayName": "Nexus Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "ROLE_BUYER",     "description": "Comprador — criacao e acompanhamento de pedidos" },
      { "name": "ROLE_SALES",     "description": "Vendas — gestao de pedidos e catalogo" },
      { "name": "ROLE_LOGISTICS", "description": "Logistica — gestao de envios e rastreamento" },
      { "name": "ROLE_ADMIN",     "description": "Administrador — acesso total" }
    ]
  },
  "clients": [
    {
      "clientId": "nexus-backend",
      "name": "Nexus Backend Services",
      "enabled": true,
      "publicClient": false,
      "secret": "nexus-backend-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:8080", "http://localhost:3000"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    },
    {
      "clientId": "nexus-frontend",
      "name": "Nexus Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    }
  ],
  "users": [
    {
      "username": "buyer",
      "email": "buyer@nexus.local",
      "firstName": "Buyer",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "buyer123", "temporary": false }],
      "realmRoles": ["ROLE_BUYER"]
    },
    {
      "username": "sales",
      "email": "sales@nexus.local",
      "firstName": "Sales",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "sales123", "temporary": false }],
      "realmRoles": ["ROLE_SALES"]
    },
    {
      "username": "logistics",
      "email": "logistics@nexus.local",
      "firstName": "Logistics",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "logistics123", "temporary": false }],
      "realmRoles": ["ROLE_LOGISTICS"]
    },
    {
      "username": "admin",
      "email": "admin@nexus.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ROLE_ADMIN", "ROLE_BUYER", "ROLE_SALES", "ROLE_LOGISTICS"]
    }
  ]
}
