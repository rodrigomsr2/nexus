#!/usr/bin/env bash
# .git/hooks/pre-commit
#
# Verifica se as alterações do commit podem exigir atualização de documentação.
# Sempre pergunta ao desenvolvedor — nunca decide sozinho.
#
# Instalação:
#   cp infra/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Para pular pontualmente (ex: commits de fixup):
#   git commit --no-verify -m "..."

set -euo pipefail

# ── Cores ─────────────────────────────────────────────────────────────────────
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

# ── Arquivos staged ───────────────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only)

if [[ -z "$STAGED" ]]; then
  exit 0
fi

# ── Detecta contexto das alterações ──────────────────────────────────────────

# Serviços com alterações (ex: orders-service, catalog-service)
CHANGED_SERVICES=$(echo "$STAGED" \
  | grep -E '^(orders|catalog|logistics|api-gateway|frontend)-' \
  | sed 's|/.*||' \
  | sort -u || true)

# Alterações em infra (docker-compose, k8s, helm, scripts)
CHANGED_INFRA=$(echo "$STAGED" \
  | grep -E '^(infra/|docker-compose|\.github/)' || true)

# Alterações em documentação
CHANGED_DOCS=$(echo "$STAGED" \
  | grep -E '\.md$' || true)

# Alterações em código (java, ts, tsx, yml de aplicação)
CHANGED_CODE=$(echo "$STAGED" \
  | grep -E '\.(java|ts|tsx|kt|yml|yaml|sh)$' || true)

# ── Monta lista de checklist contextualizada ──────────────────────────────────
CHECKLIST=()

# Por serviço alterado
for SERVICE in $CHANGED_SERVICES; do
  SERVICE_CODE=$(echo "$STAGED" | grep "^${SERVICE}/" | grep -E '\.(java|kt)$' || true)
  SERVICE_DOCS=$(echo "$STAGED" | grep "^${SERVICE}/docs/" || true)

  if [[ -n "$SERVICE_CODE" ]]; then
    CHECKLIST+=("Código de '${SERVICE}' alterado → regras de negócio mudaram? Atualizar ${SERVICE}/docs/business-rules.md")
    CHECKLIST+=("Estrutura de pacotes ou responsabilidades mudou? Atualizar ${SERVICE}/CLAUDE.md")
    CHECKLIST+=("Novos eventos Kafka publicados ou consumidos? Atualizar CLAUDE.md raiz (tabela de tópicos)")
  fi

  if [[ -n "$SERVICE_DOCS" ]]; then
    CHECKLIST+=("Documentação de '${SERVICE}' alterada → algum outro doc referencia essa informação e precisa ser atualizado?")
  fi
done

# Infra alterada
if [[ -n "$CHANGED_INFRA" ]]; then
  CHECKLIST+=("Infra alterada → comportamento operacional mudou? Atualizar docs/runbook/ correspondente")
  CHECKLIST+=("Nova dependência ou serviço adicionado? Atualizar README.md (tabela de stack ou serviços)")
  CHECKLIST+=("Configuração de segurança ou CI/CD alterada? Atualizar docs/security.md")
fi

# Qualquer alteração — perguntas gerais de arquitetura
if [[ -n "$CHANGED_CODE" || -n "$CHANGED_INFRA" ]]; then
  CHECKLIST+=("A alteração representa uma decisão arquitetural relevante? Criar ADR em docs/adr/")
fi

# Apenas documentação alterada
if [[ -z "$CHANGED_CODE" && -z "$CHANGED_INFRA" && -n "$CHANGED_DOCS" ]]; then
  CHECKLIST+=("Documentação alterada → algum outro arquivo referencia o conteúdo modificado e precisa ser atualizado?")
  CHECKLIST+=("Links ou referências cruzadas entre docs continuam válidos?")
fi

# Se não há checklist (ex: só assets, configs menores), libera sem perguntar
if [[ ${#CHECKLIST[@]} -eq 0 ]]; then
  exit 0
fi

# ── Exibe o prompt ────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}${YELLOW}┌─────────────────────────────────────────────────────────────┐${NC}"
echo -e "${BOLD}${YELLOW}│  Nexus — Verificação de documentação                        │${NC}"
echo -e "${BOLD}${YELLOW}└─────────────────────────────────────────────────────────────┘${NC}"
echo ""
echo -e "${CYAN}Arquivos alterados neste commit:${NC}"
echo "$STAGED" | sed 's/^/  /'
echo ""
echo -e "${CYAN}Considere se alguma dessas ações é necessária:${NC}"
echo ""

for item in "${CHECKLIST[@]}"; do
  echo -e "  ${YELLOW}?${NC} $item"
done

echo ""
echo -e "${CYAN}Para mais detalhes sobre onde cada tipo de doc vive:${NC}"
echo -e "  ${BOLD}CLAUDE.md${NC} (raiz do projeto)"
echo ""

# ── Confirmação explícita ─────────────────────────────────────────────────────
# Lê do terminal diretamente (não do stdin, que pode estar redirecionado pelo git)
exec < /dev/tty
read -r -p "$(echo -e "${BOLD}Documentação está em ordem? Continuar com o commit? [s/N] ${NC}")" RESPOSTA
echo ""

case "$RESPOSTA" in
  [sS])
    echo -e "${GREEN}✓ Commit aprovado.${NC}"
    echo ""
    exit 0
    ;;
  *)
    echo -e "${YELLOW}✗ Commit abortado. Atualize a documentação e tente novamente.${NC}"
    echo -e "  Dica: ${BOLD}git commit --no-verify${NC} para pular esta verificação quando necessário."
    echo ""
    exit 1
    ;;
esac
